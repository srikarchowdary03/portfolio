# Copy to .env for local development. NEVER commit .env.
ENV=local
ALLOWED_ORIGINS=http://localhost:3000

# AI providers
# Production: both providers "openai" + a real key (set a spend cap on the
# OpenAI dashboard!). Keyless development/tests: "fake" — deterministic, no
# API calls, the full app still runs.
EMBEDDINGS_PROVIDER=fake
LLM_PROVIDER=fake
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini

# Paths (defaults match the repo layout; Docker overrides CONTENT_DIR)
# CONTENT_DIR=../content
# DATA_DIR=data

# Rate limits (per client IP; defaults shown). Chat spends money -> strictest.
# RATE_LIMIT_CHAT=10/minute;60/day
# RATE_LIMIT_SEARCH=30/minute
# RATE_LIMIT_FEEDBACK=20/minute
