# Copy to .env for local development. NEVER commit .env.
ENV=local
ALLOWED_ORIGINS=http://localhost:3000

# RAG pipeline
# Production: EMBEDDINGS_PROVIDER=openai + a real key (set a spend cap!).
# Keyless development/tests: EMBEDDINGS_PROVIDER=fake (deterministic, no API calls).
EMBEDDINGS_PROVIDER=fake
# OPENAI_API_KEY=sk-...

# Path to the knowledge base (default ../content matches the repo layout).
# CONTENT_DIR=../content
